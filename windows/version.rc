#include <winver.h>
#include "src/OrcaVersion.h"

#define STRINGIFY_VALUE(value) #value
#define STRINGIFY(value) STRINGIFY_VALUE(value)
#define VERSION_TEXT STRINGIFY(KUROCAT_ORCA_RELEASE) ".0.0.0"

1 VERSIONINFO
 FILEVERSION KUROCAT_ORCA_RELEASE,0,0,0
 PRODUCTVERSION KUROCAT_ORCA_RELEASE,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KuroCat Orca Cat Desktop Pet"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "OriginalFilename", "KuroCat.exe"
            VALUE "ProductName", "KuroCat Orca Cat"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

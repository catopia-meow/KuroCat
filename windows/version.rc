#include <winver.h>
#include <SachiVersion.h>

#ifdef SACHICAT_EMBED_MANIFEST
1 24 "SachiCat.manifest"
#endif

101 RCDATA "../Resources/DopeyCat.png"

1 VERSIONINFO
 FILEVERSION SACHICAT_VERSION_FIELDS
 PRODUCTVERSION SACHICAT_VERSION_FIELDS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SachiCat Desktop Pet"
            VALUE "FileVersion", SACHICAT_VERSION_TEXT
            VALUE "OriginalFilename", "SachiCat.exe"
            VALUE "ProductName", "SachiCat"
            VALUE "ProductVersion", SACHICAT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
